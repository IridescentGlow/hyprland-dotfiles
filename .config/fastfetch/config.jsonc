{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // ─────────────────────────────────────────────────────────────────────────
  //  pewdiepie/archdaemon/dionysh — fastfetch config, translated from the old
  //  neofetch config.conf ("nord radioactive glow edition"). See that file
  //  (kept side by side, not yet deleted) for the original.
  //
  //  Translation notes / things that could NOT be carried over 1:1 — check
  //  these visually against the old neofetch output before deleting
  //  config.conf:
  //
  //  1. arch-jp.txt (the old katakana-redrawn Arch logo) does not exist
  //     anywhere on this machine — checked old and new .config paths, and
  //     searched the repo for a generator script; none found. It was
  //     apparently hand-made or generated by a one-off external tool and
  //     never committed/backed up. Using the built-in full-size "arch" logo
  //     below as an explicit placeholder instead of silently relying on
  //     fallback-on-missing-file behavior. TO RESTORE THE KATAKANA LOGO:
  //     once arch-jp.txt is recreated, it CANNOT just be dropped in with
  //     neofetch's ${c1} syntax — confirmed by testing against the two real
  //     custom ascii files this migration also touches (Au5_ascii.txt,
  //     L-ascii.txt, see hyprland.lua's fastfetch invocations): fastfetch's
  //     "file" logo type uses bare $1..$9 (no braces, no "c" prefix) as
  //     color-switch directives, and treats EVERY literal "$" in the source
  //     as the start of an escape attempt — so an ascii art file using
  //     literal "$" as a drawing/shading character (as arch-jp.txt likely
  //     does, going by its neofetch-era style) needs every one of those
  //     escaped as "$$", not just its ${cN} placeholders converted to $N.
  //     See Au5_ascii.fastfetch.txt / L-ascii.fastfetch.txt in this same
  //     directory for a verified-pixel-perfect example of the conversion.
  //     Re-verify with `fastfetch --file-raw <original>` vs.
  //     `fastfetch --file <converted>` diffed side by side before trusting
  //     it, then switch logo.type back to "file" and logo.source to the
  //     converted file's path.
  //  2. gpu_type="dedicated" (neofetch: show only the discrete GPU, hide
  //     integrated) has no equivalent found in fastfetch's gpu module docs
  //     or bundled presets/examples — fastfetch just lists every GPU it
  //     detects. Not translated; if you have both an iGPU and a dGPU,
  //     you'll now see both.
  //  3. colors=(4 2 1 3 5 6) — neofetch's 6-slot scheme colors
  //     [title, @, underline, subtitle, colon, info] separately. fastfetch's
  //     display.color only exposes title/keys/separator/output as color
  //     targets, so this is a best-effort partial mapping (title→title,
  //     colon→separator, info→output); there's no separate control for the
  //     "@" in the title or for the underline/subtitle slots.
  //  4. Theme and Icons were dropped entirely (not "no equivalent" —
  //     deliberately trimmed) to fit next to the logo without overflowing
  //     past its height. Their neofetch settings (gtk2/gtk3 theme split)
  //     are moot now that theme isn't shown; re-add from config.conf's
  //     structure if wanted. Host, Resolution, and Terminal were also cut
  //     in the same pass but later re-added once the logo switched back to
  //     the full-size "arch" (taller, more room) from "arch_small".
  //  5. speed_type="bios_limit" (report the BIOS-advertised max CPU speed,
  //     not the live/measured one) — no matching cpu module option found.
  //     Left as fastfetch's default (typically the live/current frequency).
  //  6. cpu_cores="physical" — no confirmed simple toggle for "always show
  //     physical core count only" was found; left as fastfetch's default
  //     cpu format, which may show a different core count style.
  //  7. crop_mode / crop_offset / image_size were neofetch's *image*-backend
  //     cropping options — inert under image_backend="ascii" in the old
  //     config too, so nothing was lost by dropping them here.
  //  8. block_width / block_height / col_offset (colors module block
  //     sizing) and the entire "Progress Bars" section (bar_char_elapsed/
  //     total, bar_border, bar_length, bar_color_*) have no confirmed
  //     equivalent and were dropped — the bar_* settings were already inert
  //     in the old config anyway, since disk_display="off" meant no bar was
  //     ever rendered there either.
  //  9. color_blocks="dots" was initially mapped to "symbol": "circle" (the
  //     closest enum value seen in bundled examples at the time), but that
  //     rendered too small/subtle. Confirmed via fastfetch's own JSON
  //     schema (colors module) that "symbol": "block" ("███") is the
  //     correct blocky equivalent — schema also confirms its default
  //     block.width (3) and block.range (0-15) already match neofetch's old
  //     block_width=3 / block_range=(0 15) with no extra config needed.
  // ─────────────────────────────────────────────────────────────────────────

  "logo": {
    // Explicit placeholder — arch-jp.txt doesn't exist (see note 1 above).
    // Full-size default Arch logo (the big colorful one), not a small/
    // compact variant.
    "type": "auto",
    "source": "arch",
    // gap=3
    "padding": {
      "right": 3
    }
  },

  "display": {
    // separator=":" in the old config had no trailing space. Confirmed via
    // fastfetch's own JSON schema that "display.separator" (default ": ")
    // is the right key and does print — but a bare ":" with no gap read as
    // "the separator isn't showing" against real values, so restoring the
    // space here is a deliberate deviation from the literal old value.
    "separator": ": ",
    "color": {
      // colors=(4 2 1 3 5 6): title=4(blue), colon=5(magenta), info=6(cyan)
      // — see note 3 above for why @/underline/subtitle aren't translated.
      "title": "blue",
      "separator": "magenta",
      "output": "cyan"
    },
    // bold="on" — bolds/brightens keys, title, and the ascii logo
    "brightColor": true,
    "percent": {
      // disk_percent="on" + disk_display="off": show percentages as plain
      // numbers everywhere, never as a bar.
      "type": ["num"]
    },
    "size": {
      // memory_unit="mib": force megabyte-tier display, using binary
      // (1024-based, "MiB") rather than decimal (1000-based, "MB") math.
      // fastfetch's maxPrefix enum uses "MB" as the tier name regardless of
      // binary/decimal — binaryPrefix is what actually selects MiB math.
      "maxPrefix": "MB",
      "binaryPrefix": "iec"
    }
  },

  "modules": [
    "title",
    "separator",

    { "type": "os", "key": "OS", "format": "{pretty-name} {arch}" }, // os_arch=on
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" }, // kernel_shorthand=on
    { "type": "uptime", "key": "Uptime" }, // uptime_shorthand="tiny"
    { "type": "packages", "key": "Packages", "combined": true }, // package_managers="tiny"
    { "type": "shell", "key": "Shell" }, // shell_path=off, shell_version=on (both fastfetch defaults)
    {
      "type": "display",
      "key": "Resolution",
      "compactType": "original" // refresh_rate=off: "original" omits refresh rate
    },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" }, // see notes 5 and 6
    { "type": "gpu", "key": "GPU" }, // see note 2 (dedicated-only filter dropped)
    {
      "type": "memory",
      "key": "Memory",
      "format": "{used} / {total} ({percentage})" // memory_percent=on
    },
    {
      "type": "disk",
      "key": "Disk",
      "folders": "/" // disk_show=('/')
    },

    {
      "type": "colors",
      "symbol": "block" // color_blocks="dots" — see note 9 (block, not circle)
    }
  ]
}
